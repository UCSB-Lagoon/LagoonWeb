  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Lagoon?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Lagoon is the free all-in-one campus app for UCSB students. It combines GOLD schedule sync, real grade distribution data, live dining commons menus, campus events, Daily Nexus headlines, classmate discovery, and study groups in one app."
        }
      },
      {
        "@type": "Question",
        "name": "Is Lagoon free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Lagoon is free to download on the App Store and there are no paid tiers."
        }
      },
      {
        "@type": "Question",
        "name": "Does Lagoon sync with UCSB GOLD?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Lagoon imports your registered courses from UCSB GOLD so your schedule, attendance, and finals countdown stay accurate."
        }
      },
      {
        "@type": "Question",
        "name": "Where does Lagoon's grade data come from?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Grade distributions are aggregated from UCSB's publicly released grade reports — including average GPA, A-rate, and D/F-rate for over 500 courses."
        }
      },
      {
        "@type": "Question",
        "name": "Who can use Lagoon?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Lagoon is built exclusively for UCSB undergraduates and graduate students. Sign-in requires a valid UCSB account."
        }
      }
    ]
