NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only — used by cron jobs that refresh leaderboard etc. NEVER ship to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Ads measurement — both optional; each component renders nothing when unset.
# Meta Pixel ID from Events Manager → Data sources → your pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# App Store Connect provider token (the `pt=` value from Analytics →
# Acquisition → Campaigns → Generate a Campaign Link). Enables per-campaign
# install counts in App Store Connect.
NEXT_PUBLIC_APPSTORE_PROVIDER_TOKEN=
